# Puerto del servidor backend Express (Opcional)
PORT=5000

# Clave secreta para tokens JWT (Opcional)
JWT_SECRET=tu_clave_secreta_jwt_para_admin

# ======================================================
# CONFIGURACIÓN DE GOOGLE FIREBASE CLOUD (Opcional si se configura desde el Admin)
